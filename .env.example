# Copy to .env for `netlify dev`, and set the same variables in
# Netlify: Site configuration > Environment variables.

# The password that opens the app (use a long one).
APP_PASSWORD=

# Claude API key from https://platform.claude.com (needed for AI features).
ANTHROPIC_API_KEY=

# Optional: a separate secret for signing the login cookie.
# Changing it signs everyone out.
SESSION_SECRET=

# Optional: override the Claude model (default claude-opus-5-5).
CLAUDE_MODEL=
